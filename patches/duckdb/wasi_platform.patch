diff --git a/src/common/process_util.cpp b/src/common/process_util.cpp
index 41083666e7..97d9184381 100644
--- a/src/common/process_util.cpp
+++ b/src/common/process_util.cpp
@@ -59,6 +59,9 @@ bool ProcessUtil::ProcessIsRunning(int64_t pid) {
 	auto running = GetExitCodeProcess(process, &exit_code) && exit_code == STILL_ACTIVE;
 	CloseHandle(process);
 	return running;
+#elif defined(__wasi__)
+	// no processes
+	return false;
 #else
 	// EPERM means it exists and belongs to somebody else
 	return kill(static_cast<pid_t>(pid), 0) == 0 || errno == EPERM;
