+string StringUtil::ReplaceFileName(const string &file_path, const string &file_name) {
+	auto pos = file_path.find_last_of("/\\");
+	if (pos == string::npos) {
+		return file_name;
+	}
+	return file_path.substr(0, pos + 1) + file_name;
+}
