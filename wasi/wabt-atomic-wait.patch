+static inline void memory_fill_shared(wasm_rt_shared_memory_t* mem, u64 d, u32 val, u64 n) {
+  RANGE_CHECK(mem, d, n);
+  memset((void*)MEM_ADDR(mem, d, n), val, n);
+}
+
+static inline void memory_copy_shared(wasm_rt_shared_memory_t* dest,
+                                      const wasm_rt_shared_memory_t* src,
+                                      u64 dest_addr,
+                                      u64 src_addr,
+                                      u64 n) {
+  RANGE_CHECK(dest, dest_addr, n);
+  RANGE_CHECK(src, src_addr, n);
+  memmove((void*)MEM_ADDR(dest, dest_addr, n), (const void*)MEM_ADDR(src, src_addr, n), n);
+}
+
+static inline void memory_init_shared(wasm_rt_shared_memory_t* dest,
+                                      const u8* src,
+                                      u32 src_size,
+                                      u64 dest_addr,
+                                      u32 src_addr,
+                                      u32 n) {
+  if (UNLIKELY(src_addr + (uint64_t)n > src_size))
+    TRAP(OOB);
+  RANGE_CHECK(dest, dest_addr, n);
+  load_data((void*)MEM_ADDR(dest, dest_addr, n), src + src_addr, n);
+}
