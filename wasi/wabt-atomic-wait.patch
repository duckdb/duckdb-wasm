diff --git a/src/template/wasm2c_atomicops.declarations.c b/src/template/wasm2c_atomicops.declarations.c
index d3ea511..c9473d2 100644
--- a/src/template/wasm2c_atomicops.declarations.c
+++ b/src/template/wasm2c_atomicops.declarations.c
@@ -254,3 +254,70 @@ DEFINE_ATOMIC_CMP_XCHG(i64_atomic_rmw32_cmpxchg_u, u64, u32);
 DEFINE_ATOMIC_CMP_XCHG(i64_atomic_rmw_cmpxchg, u64, u64);
 
 #define atomic_fence() atomic_thread_fence(memory_order_seq_cst)
+
+/* memory.atomic.wait32/64 and memory.atomic.notify: the runtime provides the blocking (wasm-rt-atomics.c in
+ * the embedder); a wait on an unshared memory traps, a notify on one wakes nobody. */
+int32_t wasm_rt_memory_atomic_wait32(wasm_rt_shared_memory_t* mem, u64 addr, u32 expected, int64_t timeout_ns);
+int32_t wasm_rt_memory_atomic_wait64(wasm_rt_shared_memory_t* mem, u64 addr, u64 expected, int64_t timeout_ns);
+u32 wasm_rt_memory_atomic_notify(wasm_rt_shared_memory_t* mem, u64 addr, u32 count);
+
+#define DEFINE_ATOMIC_WAIT(name, t1, rt_call)                                      \
+  static inline u32 name##_shared(uint8_t* const wasm_rt_local_memory_base,       \
+                                  uint64_t wasm_rt_local_memory_size,             \
+                                  wasm_rt_shared_memory_t* mem, u64 addr,         \
+                                  t1 expected, u64 timeout) {                     \
+    MEMCHECK_GENERAL(mem, addr, t1);                                              \
+    ATOMIC_ALIGNMENT_CHECK(addr, t1);                                             \
+    return (u32)rt_call(mem, addr, expected, (int64_t)timeout);                   \
+  }                                                                               \
+  static inline u32 name##_shared_default32(                                      \
+      uint8_t* const wasm_rt_local_memory_base,                                   \
+      uint64_t wasm_rt_local_memory_size, wasm_rt_shared_memory_t* mem,           \
+      u64 addr, t1 expected, u64 timeout) {                                       \
+    return name##_shared(wasm_rt_local_memory_base, wasm_rt_local_memory_size,    \
+                         mem, addr, expected, timeout);                           \
+  }                                                                               \
+  static inline u32 name(uint8_t* const wasm_rt_local_memory_base,                \
+                         uint64_t wasm_rt_local_memory_size,                      \
+                         wasm_rt_memory_t* mem, u64 addr, t1 expected,            \
+                         u64 timeout) {                                           \
+    MEMCHECK_GENERAL(mem, addr, t1);                                              \
+    TRAP(UNREACHABLE);                                                            \
+  }                                                                               \
+  static inline u32 name##_default32(uint8_t* const wasm_rt_local_memory_base,    \
+                                     uint64_t wasm_rt_local_memory_size,          \
+                                     wasm_rt_memory_t* mem, u64 addr,             \
+                                     t1 expected, u64 timeout) {                  \
+    return name(wasm_rt_local_memory_base, wasm_rt_local_memory_size, mem, addr,  \
+                expected, timeout);                                               \
+  }
+
+DEFINE_ATOMIC_WAIT(memory_atomic_wait32, u32, wasm_rt_memory_atomic_wait32)
+DEFINE_ATOMIC_WAIT(memory_atomic_wait64, u64, wasm_rt_memory_atomic_wait64)
+
+static inline u32 memory_atomic_notify_shared(uint8_t* const wasm_rt_local_memory_base,
+                                              uint64_t wasm_rt_local_memory_size,
+                                              wasm_rt_shared_memory_t* mem, u64 addr,
+                                              u32 count) {
+  MEMCHECK_GENERAL(mem, addr, u32);
+  ATOMIC_ALIGNMENT_CHECK(addr, u32);
+  return wasm_rt_memory_atomic_notify(mem, addr, count);
+}
+static inline u32 memory_atomic_notify_shared_default32(
+    uint8_t* const wasm_rt_local_memory_base, uint64_t wasm_rt_local_memory_size,
+    wasm_rt_shared_memory_t* mem, u64 addr, u32 count) {
+  return memory_atomic_notify_shared(wasm_rt_local_memory_base,
+                                     wasm_rt_local_memory_size, mem, addr, count);
+}
+static inline u32 memory_atomic_notify(uint8_t* const wasm_rt_local_memory_base,
+                                       uint64_t wasm_rt_local_memory_size,
+                                       wasm_rt_memory_t* mem, u64 addr, u32 count) {
+  MEMCHECK_GENERAL(mem, addr, u32);
+  return 0;
+}
+static inline u32 memory_atomic_notify_default32(
+    uint8_t* const wasm_rt_local_memory_base, uint64_t wasm_rt_local_memory_size,
+    wasm_rt_memory_t* mem, u64 addr, u32 count) {
+  return memory_atomic_notify(wasm_rt_local_memory_base, wasm_rt_local_memory_size,
+                              mem, addr, count);
+}
