@@ -238,10 +238,33 @@ void _mi_prim_out_stderr( const char* msg ) {
 // Environment
 //----------------------------------------------------------------
 
+// wasi-libc's getenv() sets up `environ` lazily with malloc, which is mimalloc itself initializing right now:
+// read the environment through the WASI calls into static storage instead
+#include <wasi/api.h>
+#include <string.h>
+static const char* mi_wasi_getenv(const char* name) {
+  static char buf[8192];
+  static char* envs[128];
+  static size_t count = 0;
+  static bool loaded = false;
+  if (!loaded) {
+    loaded = true;
+    size_t n = 0, size = 0;
+    if (__wasi_environ_sizes_get(&n, &size) != 0 || n > sizeof(envs)/sizeof(envs[0]) || size > sizeof(buf)) return NULL;
+    if (__wasi_environ_get((uint8_t**)envs, (uint8_t*)buf) != 0) return NULL;
+    count = n;
+  }
+  const size_t len = strlen(name);
+  for (size_t i = 0; i < count; i++) {
+    if (strncmp(envs[i], name, len) == 0 && envs[i][len] == '=') return envs[i] + len + 1;
+  }
+  return NULL;
+}
+
 bool _mi_prim_getenv(const char* name, char* result, size_t result_size) {
   // cannot call getenv() when still initializing the C runtime.
